# Base URL of the Media Navigator API server (Node.js + Express), no trailing slash.
# Local development: the backend started with `npm run dev` in Backend/ listens on port 8787.
#   A phone on the same Wi-Fi reaches it through this computer's LAN IP, e.g. http://192.168.0.9:8787
# Production: the HTTPS URL of the Render web service, e.g. https://media-navigator-api.onrender.com
# Only public values belong here: EXPO_PUBLIC_* variables are bundled into the app.
EXPO_PUBLIC_API_BASE_URL=
