# Root ignore rules for the Media Navigator monorepo.
# Frontend/ and Backend/ keep their own tool-generated .gitignore files as well.

# Dependencies
node_modules/

# Secrets and local environment files (templates are committed)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# Cloudflare Wrangler local state (local D1/R2/KV data)
.wrangler/

# Expo generated files and build outputs
.expo/
expo-env.d.ts
dist/
web-build/
Frontend/ios/
Frontend/android/
*.tsbuildinfo
coverage/

# Logs
*.log
npm-debug.*
.metro-health-check*

# OS / editor
.DS_Store
Thumbs.db
