# Media Navigator API — copy to .env for local development. Never commit .env.
# In production (Render) set these in the service's Environment tab instead.

NODE_ENV=development
# Render sets PORT itself; locally the app and the Expo client use 8787.
PORT=8787
HOST=0.0.0.0
# Number of reverse proxies in front of the app (Render: 1).
TRUST_PROXY=0

# Local: the MongoDB server on this machine (inspect it with MongoDB Compass).
# Production: a remotely reachable deployment such as MongoDB Atlas — never localhost.
MONGODB_URI=mongodb://127.0.0.1:27017/media_navigator

# Comma-separated browser origins (only for the Expo web target). Native apps need nothing here.
CORS_ALLOWED_ORIGINS=

# At least 32 random characters. Encrypts platform access tokens (AES-256-GCM).
# Changing it makes every stored platform credential unreadable (users must reconnect).
ENCRYPTION_KEY=

# Gemini (server only — never put this in Expo).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Meta app (Instagram + Facebook Pages).
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_REDIRECT_URI=https://YOUR-API-HOST/api/accounts/callback/instagram
FACEBOOK_REDIRECT_URI=https://YOUR-API-HOST/api/accounts/callback/facebook

# Google OAuth client (YouTube Data API v3 + YouTube Analytics API enabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-API-HOST/api/accounts/callback/youtube

# LinkedIn app with Community Management API access.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://YOUR-API-HOST/api/accounts/callback/linkedin
LINKEDIN_API_VERSION=202509

# App deep-link schemes the OAuth callback may return to (exp = Expo Go during development).
APP_REDIRECT_SCHEMES=medianavigator,exp

# Cloudflare R2 (S3-compatible API). R2_ENDPOINT defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Rate limits
AUTH_RATE_LIMIT=30
API_RATE_LIMIT=300
AI_REQUESTS_PER_HOUR=40
