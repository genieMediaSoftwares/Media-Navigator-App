/**
 * Wrangler configuration for the Media Navigator API.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * D1 and KV bindings intentionally omit resource IDs: `wrangler deploy` provisions them
 * automatically. Once created, add the real `database_id` / `id` here (see PROJECT_SETUP.md).
 * After changing bindings run `npm run cf-typegen`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "media-navigator-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-25",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Relational data (users, accounts, posts, metrics). Schema changes go in ./migrations.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "media-navigator-db",
			"migrations_dir": "migrations"
		}
	],
	// Media and export files.
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "media-navigator-media"
		}
	],
	// Short-lived cache and session data.
	"kv_namespaces": [
		{
			"binding": "CACHE"
		}
	],
	// Non-secret configuration. CORS_ALLOWED_ORIGINS: comma-separated browser origins allowed to
	// call the API (only needed for the Expo web target). Empty means none. Override locally in .dev.vars.
	"vars": {
		"CORS_ALLOWED_ORIGINS": "",
		"META_API_VERSION": "v21.0",
		// Gemini model used by the Worker for AI analysis (services/gemini.ts).
		"GEMINI_MODEL": "gemini-3.5-flash"
	},
	// Set locally in .dev.vars, in production with `wrangler secret put <NAME>`.
	"secrets": {
		"required": [
			"GEMINI_API_KEY",
			"META_APP_ID",
			"META_APP_SECRET",
			"META_REDIRECT_URI",
			"ENCRYPTION_KEY"
		]
	}
}